<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Don't rewrite existing files or directories
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  
  # Don't rewrite sitemap.xml
  RewriteCond %{REQUEST_URI} !^/sitemap\.xml$
  
  # Rewrite everything else to index.html to allow client-side routing
  # This includes /prosfora50 - React Router will handle it
  RewriteRule ^ index.html [L]
</IfModule>

# Fallback: If mod_rewrite is not available, serve prosfora50.html for /prosfora50
<IfModule !mod_rewrite.c>
  # This is a fallback - ideally mod_rewrite should be enabled
</IfModule>

# Ensure proper MIME types
<IfModule mod_mime.c>
  AddType application/xml .xml
</IfModule>

# Enable compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
